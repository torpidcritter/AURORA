# Copy to .env for local development. Never commit real secrets.
ENVIRONMENT=development
API_PORT=8100
API_CORS_ORIGINS=http://localhost:3100,http://127.0.0.1:3100
LOG_LEVEL=INFO
LOG_JSON=true

DATABASE_URL=postgresql+psycopg://aurora:aurora@localhost:5432/aurora
REDIS_URL=redis://localhost:6379/0

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Used only by `python -m app.cli bootstrap` to create the first admin.
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=

STORAGE_BACKEND=local            # local | s3
ARTIFACT_DIR=./artifacts
S3_ENDPOINT_URL=                 # e.g. http://minio:9000 for MinIO
S3_BUCKET=aurora
S3_ACCESS_KEY=
S3_SECRET_KEY=

ANTHROPIC_API_KEY=               # optional; the assistant falls back to deterministic answers without it
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_EFFORT=low              # low | medium | high | xhigh | max
ANTHROPIC_SERVER_FALLBACK=true

SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_REDIRECT_URL=http://localhost:8100/shopify/callback

ALERT_WEBHOOK_URL=               # optional HTTPS endpoint receiving high/critical alerts
METRICS_TOKEN=                   # when set, /metrics requires "Authorization: Bearer <token>"
