# Copy to .env for local development. Never commit real secrets.
ENVIRONMENT=development
API_PORT=8100
API_CORS_ORIGINS=http://localhost:3100,http://127.0.0.1:3100
LOG_LEVEL=INFO
LOG_JSON=true

DATABASE_URL=postgresql+psycopg://aurora:aurora@localhost:5432/aurora
# Spec names are also accepted instead of DATABASE_URL (which wins when both are set):
# DB_HOST=localhost  DB_PORT=5432  DB_NAME=aurora  DB_USER=aurora  DB_PASSWORD=...
# AUTH_ENABLED=false, DB_ENABLED=false and DB_TYPE other than postgresql are refused at startup.
# Runtime role created by `python -m app.cli grant-app-role` (run as the schema owner after migrations):
APP_DB_ROLE=aurora_app
APP_DB_PASSWORD=
REDIS_URL=redis://localhost:6379/0

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
# Admin-issued one-time password reset links (no e-mail is sent) expire after this many minutes (5 to 10080).
# The links point at FRONTEND_URL, so set it to the address users open.
PASSWORD_RESET_TTL_MINUTES=60
FRONTEND_URL=http://localhost:3100

# Used only by `python -m app.cli bootstrap` to create the first admin.
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=

STORAGE_BACKEND=local            # local | s3
ARTIFACT_DIR=./artifacts
S3_ENDPOINT_URL=                 # e.g. http://minio:9000 for MinIO
S3_BUCKET=aurora
S3_ACCESS_KEY=
S3_SECRET_KEY=

ANTHROPIC_API_KEY=               # optional; the assistant falls back to deterministic answers without it
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_EFFORT=low              # low | medium | high | xhigh | max
ANTHROPIC_SERVER_FALLBACK=true

SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_REDIRECT_URL=http://localhost:8100/shopify/callback
SHOPIFY_API_SECRET_PREVIOUS=     # old secret, accepted for HMAC checks only during a rotation
SHOPIFY_WEBHOOK_BASE_URL=        # public HTTPS base of this API; defaults to the origin of SHOPIFY_REDIRECT_URL
TOKEN_ENCRYPTION_KEYS=           # Fernet keys, newest first; required when Shopify is enabled

ALERT_WEBHOOK_URL=               # optional HTTPS endpoint receiving alerts at or above ALERT_MIN_SEVERITY
ALERT_MIN_SEVERITY=high          # low | medium | high | critical; each organisation can override it in Settings
METRICS_TOKEN=                   # when set, /metrics requires "Authorization: Bearer <token>"
