# Docker Compose settings. Copy to .env and fill in. Never commit .env.
# Generate secrets with: python -c "import secrets; print(secrets.token_urlsafe(48))"
POSTGRES_PASSWORD=
SECRET_KEY=
PUBLIC_URL=http://localhost:3100
# Set to true when users reach the app over HTTPS (required in production).
COOKIE_SECURE=false

# First admin, used once by `docker compose run --rm api python -m app.cli bootstrap`.
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=

# Optional integrations
ANTHROPIC_API_KEY=
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_REDIRECT_URL=http://localhost:8100/shopify/callback
# Required when Shopify is enabled: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEYS=
METRICS_TOKEN=
ALERT_WEBHOOK_URL=
