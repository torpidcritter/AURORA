# Docker Compose settings. Copy to .env and fill in. Never commit .env.
# Generate secrets with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Schema owner, used only by the one-off `migrate` container.
POSTGRES_PASSWORD=
# Runtime role (aurora_app) used by the API, worker and beat: rows only, no schema changes. At least 16 characters.
APP_DB_PASSWORD=
SECRET_KEY=
PUBLIC_URL=http://localhost:3100
# The web image always sets Secure session cookies. Browsers accept them on http://localhost;
# any other address needs HTTPS (see docs/RUNBOOK.md).

# First admin, used once by `docker compose run --rm api python -m app.cli bootstrap`.
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=

# Optional integrations
ANTHROPIC_API_KEY=
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_REDIRECT_URL=http://localhost:8100/shopify/callback
# Required when Shopify is enabled: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEYS=
METRICS_TOKEN=
ALERT_WEBHOOK_URL=
# Lowest alert severity sent to the log/webhook (low | medium | high | critical; default high). Organisations can
# override it on the Settings page.
ALERT_MIN_SEVERITY=
# Old Shopify secret, accepted for verification only while rotating.
SHOPIFY_API_SECRET_PREVIOUS=
# Public HTTPS address of the API that Shopify calls (webhooks need HTTPS).
SHOPIFY_WEBHOOK_BASE_URL=

# Optional object storage. Leave empty to keep files on the artifacts volume.
# For the bundled MinIO (development only): COMPOSE_PROFILES=s3, STORAGE_BACKEND=s3,
# S3_ENDPOINT_URL=http://minio:9000, S3_ACCESS_KEY and S3_SECRET_KEY (8+ characters). Console: http://localhost:9001
COMPOSE_PROFILES=
STORAGE_BACKEND=
S3_ENDPOINT_URL=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Optional tuning; empty means the application default.
LOG_LEVEL=
API_RATE_LIMIT_PER_MINUTE=
ANTHROPIC_MODEL=
ANTHROPIC_EFFORT=
TRAINING_MAX_EPOCHS=
